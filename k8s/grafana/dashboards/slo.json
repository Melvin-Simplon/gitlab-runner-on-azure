{
  "uid": "slo",
  "title": "SLO",
  "description": "Service level objectives of the platform, measured over 14 days because VictoriaMetrics keeps 15 days.",
  "tags": [
    "slo"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Grafana answers without error (objective 99%)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI over 14d",
      "description": "Share of Grafana requests seen by Traefik that did not end in a 5xx error.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - (sum(increase(traefik_service_requests_total{service=\"monitoring-grafana-80@kubernetes\",code=~\"5..\"}[14d])) or vector(0)) / sum(increase(traefik_service_requests_total{service=\"monitoring-grafana-80@kubernetes\"}[14d]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
