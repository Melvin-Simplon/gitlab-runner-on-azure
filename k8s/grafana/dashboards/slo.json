{
  "uid": "slo",
  "title": "Runner SLO",
  "description": "Do we have working runners, all the time? SLOs over 30 days, read from the vmalert recording rules.",
  "tags": [
    "slo"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Do we have working runners, all the time?** Each objective is measured over the last 30 days. Definitions, alerts and the error budget policy are in [docs/slo.md](https://gitlab.com/WhiteMuush/gitlab-runner-on-azure/-/blob/main/docs/slo.md)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Runner is reachable (objective 99%)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI over 30 days",
      "description": "Share of minutes where the runner answered, while the cluster runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{slo=\"runner-reachable\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
