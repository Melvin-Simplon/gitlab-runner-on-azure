# Copy this file to .env, which git ignores.
AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Entra accounts that get cluster admin, space separated
CLUSTER_ADMINS=prenom.ext@simplonformations.co autre.ext@simplonformations.co
# GitLab username and token (scope api) used to read the Terraform state.
GITLAB_USER=your-gitlab-username
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Runner authentication token, from Settings > CI/CD > Runners > New project runner
GITLAB_RUNNER_TOKEN=glrt-xxxxxxxxxxxxxxxxxxxx
